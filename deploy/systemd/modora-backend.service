[Unit]
Description=MoDora Backend API
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/project/modora/MoDora-backend
Environment=MODORA_CONFIG=/root/project/modora/local.json
ExecStart=/root/project/modora/MoDora-backend/venv/bin/python -m uvicorn modora.api.app:app --host 127.0.0.1 --port 8005
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
